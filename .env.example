# Copy to .env and fill in. Never commit the real .env.
APP_NAME="Smart OPD Scheduler"
ENVIRONMENT=development
DEBUG=true

# SQLite for local dev; swap for postgresql+psycopg://user:pass@host/db in production
DATABASE_URL=sqlite:///./opd.db

# Room 10 - generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level encryption key for PII at rest (Room 10)
# python -c "import secrets;print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEY=change-me-too

# Room 1 - device gateway shared secret
DEVICE_API_KEY=dev-device-key

# Room 6 - notification providers (console driver used when blank)
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
VOICE_PROVIDER=console

# Room 9 - government integrations (sandbox by default)
ABHA_BASE_URL=https://sandbox.abdm.gov.in
ABHA_CLIENT_ID=
ABHA_CLIENT_SECRET=
ORS_BASE_URL=https://sandbox.ors.gov.in
ORS_API_KEY=
HMIS_FHIR_BASE_URL=
HMIS_FHIR_TOKEN=
